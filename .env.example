# Root-level env file, auto-loaded by `docker compose up` (docker-compose.yml
# lives in this same directory). Copy this to .env and fill in real values to
# enable "Continuar com Google" in local dev.
#
# Get these at https://console.cloud.google.com/apis/credentials
#   1. Create (or reuse) a project, then "Create credentials" -> "OAuth client ID"
#   2. Application type: "Web application"
#   3. Authorized redirect URI: http://localhost:8080/api/auth/google/callback
#   4. Copy the generated Client ID and Client secret below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
